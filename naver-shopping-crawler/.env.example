# 네이버 개발자 API 키
# https://developers.naver.com 에서 발급
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# 데이터베이스 경로
DATABASE_URL=sqlite+aiosqlite:///./data.db

# 크롤링 설정
CRAWL_DELAY=1.5
MAX_CONCURRENT_CRAWL=3

# 공정거래위원회 API 키 (통신판매사업자 전화번호 조회용)
# https://www.data.go.kr/data/15126315/openapi.do 에서 발급
FTC_API_KEY=your_ftc_api_key_here

# 카카오 REST API 키 (전화번호 조회용)
# https://developers.kakao.com 에서 발급
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
